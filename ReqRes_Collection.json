                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Validate name and job from CSV\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedName = pm.iterationData.get(\"name\") || data.name;",
                  "    var expectedJob = pm.iterationData.get(\"job\") || data.job;",
                  "    pm.expect(jsonData.name).to.eql(expectedName);",
                  "    pm.expect(jsonData.job).to.eql(expectedJob);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"userId\", jsonData.id);"
                ]
              }
            }
